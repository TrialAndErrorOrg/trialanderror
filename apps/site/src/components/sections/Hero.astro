---
import type { Section } from "~/content.config";
import Markdown from "../Markdown.astro";
import SectionHero from "../SectionHero.astro";

type Props = Extract<Section, { type: "hero" }>;
const { title, subtitle, text, buttons, color } = Astro.props;

// Each line of the title gets its own box, like the old sites' logos
const lines = title.split("\n").filter(Boolean);
const journal = color === "journal";
---

<SectionHero lines={lines} color={color}>
	{subtitle && <p class="font-heading text-2xl leading-tight font-bold tracking-tighter md:text-3xl">{subtitle}</p>}
	{text && <Markdown text={text} class="text-lg" />}
	{
		buttons.length > 0 && (
			<div class="flex flex-wrap gap-4">
				{buttons.map((b) => (
					<a href={b.url} class:list={["button", b.style === "plain" ? "button-plain" : journal && "button-journal"]}>
						{b.label}
					</a>
				))}
			</div>
		)
	}
	<slot />
</SectionHero>
