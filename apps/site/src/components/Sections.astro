---
import type { Section } from "~/content.config";
import Buttons from "./sections/Buttons.astro";
import CardsSection from "./sections/CardsSection.astro";
import Chooser from "./sections/Chooser.astro";
import Contents from "./sections/Contents.astro";
import Features from "./sections/Features.astro";
import Hero from "./sections/Hero.astro";
import Issues from "./sections/Issues.astro";
import LatestArticles from "./sections/LatestArticles.astro";
import LatestPosts from "./sections/LatestPosts.astro";
import Newsletter from "./sections/Newsletter.astro";
import StepsSection from "./sections/StepsSection.astro";
import Team from "./sections/Team.astro";
import Text from "./sections/Text.astro";

interface Props {
	sections: Section[];
}

// To add a section type: make a component in ./sections, add it here,
// and describe its fields in src/content.config.ts and src/admin/config.yml
const components = {
	hero: Hero,
	text: Text,
	features: Features,
	"latest-posts": LatestPosts,
	"latest-articles": LatestArticles,
	issues: Issues,
	team: Team,
	newsletter: Newsletter,
	buttons: Buttons,
	contents: Contents,
	chooser: Chooser,
	cards: CardsSection,
	steps: StepsSection,
} satisfies Record<Section["type"], unknown>;

const { sections } = Astro.props;

// "On this page" lists the sections after it that have an anchor and a title
const linksAfter = (index: number) =>
	sections.slice(index + 1).flatMap((s) => {
		if (!("id" in s) || !s.id || !("title" in s) || !s.title) return [];
		const label = ("short" in s && s.short) || s.title;
		return [{ id: s.id, label }];
	});
---

{
	sections.map((section, i) => {
		const Component = components[section.type] as any;
		return section.type === "contents" ? <Contents title={section.title} links={linksAfter(i)} /> : <Component {...section} />;
	})
}
