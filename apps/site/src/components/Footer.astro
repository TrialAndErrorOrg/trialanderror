---
import { Icon } from "astro-icon/components";
import { BRANDS, sectionOf } from "~/lib/section";
import { navigation, site } from "~/lib/settings";
import Brand from "./Brand.astro";
import SocialIcon from "./SocialIcon.astro";

const section = sectionOf(Astro.url.pathname);
---

<footer class:list={["mt-24 border-t-heavy border-ink text-ink", BRANDS[section].soft]}>
	<div class="page grid gap-12 py-16 md:grid-cols-[1fr_2fr]">
		<div class="flex flex-col gap-6">
			<Brand section={section} large class="self-start" />
			<p class="max-w-sm">{site.description}</p>
			<ul class="flex flex-wrap gap-4">
				{
					navigation.socials.map((social) => (
						<li>
							<a href={social.url} class="block border-frame border-ink bg-paper p-2 transition-all hover:-translate-y-0.5 hover:shadow-hard" aria-label={social.icon}>
								<SocialIcon icon={social.icon} class="size-5" />
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<div class="grid grid-cols-2 gap-8 md:grid-cols-3">
			{
				navigation.footer.map((column) => (
					<div>
						<h2 class="mb-4 font-heading text-lg font-black">{column.title}</h2>
						<ul class="flex flex-col gap-2">
							{column.children?.map((link) => (
								<li>
									<a href={link.url} class="underline-offset-4 hover:underline">
										{link.title}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
	<div class="border-t-frame border-ink bg-paper">
		<div class="page flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-6 text-sm text-muted">
			<p>
				© {new Date().getFullYear()} Stichting Center of Trial and Error. Content is CC BY 4.0 unless noted otherwise.
				<a href="https://github.com/TrialAndErrorOrg/trialanderror/tree/main/apps/site" class="underline">Source code</a>.
			</p>
			<a href="/admin" class="inline-flex items-center gap-1.5 underline-offset-4 hover:text-ink hover:underline" rel="nofollow">
				<Icon name="lucide:lock" class="size-3.5" aria-hidden="true" /> Editor sign-in
			</a>
		</div>
	</div>
</footer>
