---
import BlogMasthead from "~/components/BlogMasthead.astro";
import Pagination from "~/components/Pagination.astro";
import PostList from "~/components/PostList.astro";
import type { Post } from "~/lib/types";
import Base from "./Base.astro";

interface Props {
	title: string;
	/** Small label above the title, e.g. "Category" */
	kicker?: string;
	description?: string;
	posts: Post[];
	page?: { current: number; total: number; href: (n: number) => string };
	featureFirst?: boolean;
	/** The masthead link to mark: a category's slug, or "all" for the archive */
	current?: string;
}

const { title, kicker, description, posts, page, featureFirst = false, current } = Astro.props;
---

<Base title={title} description={description}>
	<BlogMasthead current={current} compact />
	<div class="page flex flex-col gap-4 pt-12">
		{kicker && <p class="font-heading text-sm font-bold tracking-widest text-muted uppercase">{kicker}</p>}
		<h1 class="font-heading text-5xl leading-none font-black tracking-tighter md:text-7xl">{title}</h1>
		{description && <p class="max-w-3xl text-lg md:text-xl">{description}</p>}
		<slot name="header" />
	</div>
	<div class="page py-12">
		<slot />
		<PostList posts={posts} featureFirst={featureFirst} />
		{page && <Pagination {...page} />}
	</div>
</Base>
