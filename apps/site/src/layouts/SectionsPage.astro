---
import type { PageData } from "~/content.config";
import JournalNav from "~/components/JournalNav.astro";
import Sections from "~/components/Sections.astro";
import type { Journal } from "~/lib/sources/journal";
import Base from "./Base.astro";

interface Props {
	page: PageData;
	/** Draw it as one of the journal's pages, with its menu and colours */
	journal?: Journal;
	/** The search section it's filed under, or leave it out of search */
	searchSection?: string;
}

/* A page built from sections in site-content: pages/<slug>.yaml, or pages/journal/<slug>.yaml for the journal. Also drawn by /admin's preview */
const { page, journal, searchSection } = Astro.props;
// A journal page's tab names the journal too, as its PubPub pages do
const title = journal && page.title !== journal.config.title ? `${page.title} | ${journal.config.title}` : page.title;
---

<Base title={title} description={page.description} class={journal?.config.theme}>
	{journal && <JournalNav journal={journal} />}
	{
		page.showTitle &&
			(journal ? (
				// Like the journal's PubPub pages (JournalPage.astro): the journal's name, the title and the description
				<div class="border-b-frame border-ink bg-journal text-paper">
					<div class="page flex flex-col gap-4 py-12 md:py-16">
						<a href={journal.config.path} class="label self-start bg-paper text-ink hover:bg-journal-soft">
							{journal.config.title}
						</a>
						<h1 class="font-heading text-5xl leading-[1.05] font-black tracking-tighter md:text-7xl">{page.title}</h1>
						{page.description && <p class="max-w-3xl text-lg font-medium md:text-xl">{page.description}</p>}
					</div>
				</div>
			) : (
				<div class="border-b-frame border-ink bg-accent">
					<div class="page py-12 md:py-20">
						<h1 class="font-heading text-5xl font-black tracking-tighter md:text-8xl">{page.title}</h1>
					</div>
				</div>
			))
	}
	{
		searchSection ? (
			<div data-pagefind-body data-pagefind-filter={`section:${searchSection}`}>
				<span hidden data-pagefind-meta="title">
					{page.title}
				</span>
				<Sections sections={page.sections} />
			</div>
		) : (
			<Sections sections={page.sections} />
		)
	}
</Base>
