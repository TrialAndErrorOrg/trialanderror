---
import type { GetStaticPaths } from "astro";
import { getCollection, type CollectionEntry } from "astro:content";
import AdConsent from "~/components/AdConsent.astro";
import SectionsPage from "~/layouts/SectionsPage.astro";
import { site } from "~/lib/settings";

// Every page in site-content's pages/, except those with a page of their own
export const getStaticPaths = (async () => {
	// The homepage and the journal's front page have pages of their own (index.astro, journal/index.astro)
	const OWN_PAGES = ["index", "journal"];
	// pages/journal/* are the journal's (journal/[slug].astro)
	const local = (await getCollection("pages")).filter((p) => !OWN_PAGES.includes(p.id) && !p.id.startsWith("journal/"));
	return local.map((page) => ({ params: { slug: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: CollectionEntry<"pages"> };
const tracksAds = site.adTracking?.pages.includes(Astro.params.slug ?? "") ?? false;
---

<SectionsPage page={page.data} searchSection="Page">
	{tracksAds && <AdConsent />}
</SectionsPage>
