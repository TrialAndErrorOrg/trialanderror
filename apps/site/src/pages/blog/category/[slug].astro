---
import type { GetStaticPaths } from "astro";
import BlogList from "~/layouts/BlogList.astro";
import { getCategories } from "~/lib/sources/blog";

export const getStaticPaths = (async () =>
	(await getCategories()).map((term) => ({ params: { slug: term.slug }, props: { term } }))) satisfies GetStaticPaths;

const { term } = Astro.props;
---

<BlogList title={term.title} kicker="Category" description={term.description} posts={term.posts} />
